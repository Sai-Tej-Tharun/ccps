# Copy this file to .env and adjust as needed. docker-compose and both
# backends read from this single file so the DB credentials only need to
# be defined once, consistently, in one place.

# --- MySQL ---
DB_NAME=ccps_db
DB_USER=ccps_user
DB_PASSWORD=ccps_password
DB_ROOT_PASSWORD=ccps_root_password
DB_HOST=mysql
DB_PORT=3306

# --- Django ---
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared between Django (issues tokens) and FastAPI (verifies them) — both
# MUST have the exact same value, or FastAPI will reject every token.
JWT_SHARED_SECRET=change-this-to-a-different-long-random-string
ACCESS_TOKEN_LIFETIME_MIN=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# Demo admin, seeded automatically on container start (see
# django_backend/accounts/management/commands/create_demo_admin.py).
# Change the password before using this anywhere beyond local evaluation.
DEMO_ADMIN_USERNAME=admin
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=StrongPass123!

# --- FastAPI ---
# Leave unset to let fastapi_backend build its own connection string from
# the DB_* vars above; set this directly only if you need a different URL.
# FASTAPI_DATABASE_URL=mysql+pymysql://ccps_user:ccps_password@mysql:3306/ccps_db


# --- E-mail alerts -------------------------------------------------------------
# Leave EMAIL_HOST empty to only log/print e-mails during development.
# Gmail example: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USE_TLS=True and an
# App Password (never your normal password) in EMAIL_HOST_PASSWORD.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=LedgerPay Alerts <no-reply@ledgerpay.local>

# Alert rules (read by fastapi_backend/notifications.py)
ALERT_LARGE_TRANSACTION_AMOUNT=5000
ALERT_LOW_CREDIT_PERCENT=10

# --- Fraud detection (read by fastapi_backend/fraud.py) ------------------------
FRAUD_HIGH_VALUE_AMOUNT=2000
FRAUD_HIGH_VALUE_COUNT=3
FRAUD_WINDOW_MINUTES=10
FRAUD_SOURCE_COUNT=2
# Stakeholders who also get an e-mail for every flagged transaction (comma separated)
FRAUD_ALERT_RECIPIENTS=

# --- Monitoring ----------------------------------------------------------------
REQUEST_METRICS_ENABLED=True
SLOW_REQUEST_MS=1000
REQUEST_LOG_RETENTION_DAYS=14
FASTAPI_HEALTH_URL=http://fastapi_backend:8001/health